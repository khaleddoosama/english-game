{
  "about": "Shared cases of the word contract (ADR 0011): each is run against checkWord (src/engine/wordContract.js, tests/word-contract.test.js) and against public.word_contract_errors in SQL (tests/integration/word-contract-sql.test.js). A case starts from base, then sets the keys in set and removes the keys in unset (a dotted path reaches inside an object). errors lists 'path: code', in any order. Made-up words only.",
  "base": {
    "word": "Ferry",
    "id": "w-ferry",
    "type": "vocab",
    "category": "Travel",
    "subCategory": "Boats",
    "units": ["Unit 4"],
    "level": "A2.2",
    "partsOfSpeech": ["noun"],
    "meaning": "A boat that carries people and cars across water.",
    "situations": ["We took the ferry to the island.", "The ferry was late because of the wind."],
    "gaps": ["The ______ leaves the harbour every hour, so we can bring the car.", "Cars drove onto the ______ before it crossed the river."],
    "hints": ["It floats.", "It can carry cars."],
    "commonMistakes": [{ "sentence": "We went by the ferry.", "correction": "We went by ferry.", "why": "After 'by' we use the transport without 'the'." }],
    "confusableWords": ["Raft"],
    "collocationChecks": [{ "sentence": "We need to ______ the ferry at six.", "answer": "catch", "wrong": ["hold", "keep"] }],
    "wordFamily": [{ "word": "ferryman", "pos": "noun" }],
    "learningData": { "cluster": "transport" },
    "contract": 1
  },
  "cases": [
    { "name": "the base word is valid", "errors": [] },
    { "name": "every optional key may be left out", "unset": ["id", "subCategory", "units", "level", "partsOfSpeech", "hints", "commonMistakes", "confusableWords", "collocationChecks", "wordFamily", "learningData"], "errors": [] },
    { "name": "a phrasal verb with a transform example, a plain form, a picture and a drawing", "set": { "word": "Give up", "type": "phrasal", "partsOfSpeech": ["phrasal verb"], "transformExample": { "before": "Stop trying.", "after": "Give up." }, "plainForm": "stop trying", "image": "https://example.org/give-up.webp", "illustration": "<svg viewBox=\"0 0 10 10\"><path d=\"M0 0\"/></svg>" }, "errors": [] },
    { "name": "a course level, a plain difficulty and every system key are valid", "set": { "level": "B1", "categoryId": "travel", "subCategoryTitle": "Boats and ships", "_aiAdded": true, "gapsCheckedFor": "x", "distractorGroup": "boats", "excludeFromSameOptionsWith": ["Boat"], "pictureAvoid": ["Ship"], "antonyms": ["Bridge"], "synonyms": ["Boat"], "collocations": ["take a ferry"] }, "errors": [] },
    { "name": "a stub needs no examples and no gaps", "set": { "_autoStub": true }, "unset": ["situations", "gaps"], "errors": [] },

    { "name": "not an object", "replace": ["Ferry"], "errors": ["$: not-object"] },
    { "name": "required keys missing", "unset": ["word", "type", "category", "meaning", "situations", "gaps"], "errors": ["word: required", "type: required", "category: required", "meaning: required", "situations: required", "gaps: required"] },
    { "name": "the contract marker missing", "unset": ["contract"], "errors": ["contract: required"] },
    { "name": "the contract marker is not 1", "set": { "contract": true }, "errors": ["contract: type"] },
    { "name": "empty values are never stored", "set": { "hints": [], "subCategory": "  ", "learningData": {}, "id": null }, "errors": ["hints: empty", "subCategory: empty", "learningData: empty", "id: empty"] },
    { "name": "an empty required value", "set": { "meaning": "" }, "errors": ["meaning: empty"] },
    { "name": "false and 0 are values of the wrong type, not empty", "set": { "level": 0, "plainForm": false, "_aiAdded": false }, "errors": ["level: type", "plainForm: type", "_aiAdded: true-only"] },
    { "name": "unknown, retired, derived and alias keys", "set": { "acceptedWrittenAnswers": ["boat"], "register": "informal", "chainGroup": "x", "situation": "We took the ferry.", "opposite": "Bridge", "relations": { "synonyms": ["Boat"] }, "example": "x", "colour": "blue" }, "errors": ["acceptedWrittenAnswers: retired-key", "register: retired-key", "chainGroup: retired-key", "situation: not-stored", "opposite: not-stored", "relations: not-stored", "example: not-stored", "colour: unknown-key"] },
    { "name": "type and level outside their lists", "set": { "type": "slang", "level": "Beginner" }, "errors": ["type: enum", "level: enum"] },
    { "name": "texts that are too long", "set": { "word": "W", "category": "C", "meaning": "M" }, "repeat": { "word": 121, "category": 61, "meaning": 301 }, "errors": ["word: too-long", "category: too-long", "meaning: too-long"] },
    { "name": "a list that is not a list, and items of the wrong kind", "set": { "units": "Unit 4", "hints": ["ok", 3, " "] }, "errors": ["units: type", "hints[1]: type", "hints[2]: empty"] },
    { "name": "a gap needs exactly one blank", "set": { "gaps": ["We took the ferry.", "We took the ______ to the ______."] }, "errors": ["gaps[0]: one-blank", "gaps[1]: one-blank"] },
    { "name": "an example has no blank", "set": { "situations": ["We took the ______ home."] }, "errors": ["situations[0]: has-blank"] },
    { "name": "repeats inside a list, ignoring case", "set": { "situations": ["We took the ferry.", "we took the ferry."], "antonyms": ["Bridge", "bridge"] }, "errors": ["situations[1]: repeat", "antonyms[1]: repeat"] },
    { "name": "parts of speech from the game's list, at most 3", "set": { "partsOfSpeech": ["noun", "thing", "verb", "adjective"] }, "errors": ["partsOfSpeech[1]: enum", "partsOfSpeech: too-many"] },
    { "name": "a transform example on a vocab word, with a missing part", "set": { "transformExample": { "before": "Stop trying." } }, "errors": ["transformExample.after: empty", "transformExample: wrong-word-type"] },
    { "name": "a common mistake whose correction equals the sentence (case, spaces and end punctuation ignored)", "set": { "commonMistakes": [{ "sentence": "We went by  ferry.", "correction": "we went by ferry", "why": "x" }] }, "errors": ["commonMistakes[0]: same-as-correction"] },
    { "name": "a common mistake with a missing part and an extra key", "set": { "commonMistakes": [{ "sentence": "a", "correction": "b", "note": "x" }] }, "errors": ["commonMistakes[0].why: empty", "commonMistakes[0].note: unknown-key"] },
    { "name": "Word Partners: one blank, an answer, at least two different wrong options", "set": { "collocationChecks": [{ "sentence": "We need to catch the ferry.", "answer": "", "wrong": ["catch"] }] }, "errors": ["collocationChecks[0].sentence: one-blank", "collocationChecks[0].answer: empty", "collocationChecks[0].wrong: too-few"] },
    { "name": "Word Partners: a wrong option equal to the answer", "set": { "collocationChecks": [{ "sentence": "We need to ______ the ferry.", "answer": "catch", "wrong": ["Catch", "keep"] }] }, "errors": ["collocationChecks[0].wrong: equals-answer"] },
    { "name": "word family: a member without a word", "set": { "wordFamily": [{ "pos": "noun" }, { "word": "ferries" }] }, "errors": ["wordFamily[0].word: empty"] },
    { "name": "a picture link that is not https, and a drawing with a script", "set": { "image": "data:image/png;base64,AAAA", "illustration": "<svg><script>x</script></svg>" }, "errors": ["image: https", "illustration: svg"] },
    { "name": "learningData keeps only cluster", "set": { "learningData": { "cluster": "transport", "difficulty": "easy" } }, "errors": ["learningData.difficulty: retired-key"] },
    { "name": "learningData without cluster", "set": { "learningData": { "level": "x" } }, "errors": ["learningData.level: unknown-key", "learningData.cluster: required"] },
    { "name": "a stub flag that is not true", "set": { "_autoStub": "yes" }, "errors": ["_autoStub: true-only"] },
    { "name": "system texts must not be empty or of the wrong type", "set": { "categoryId": 7, "gapsCheckedFor": "" }, "errors": ["categoryId: type", "gapsCheckedFor: empty"] }
  ]
}
